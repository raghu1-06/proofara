# ==============================================================================
# Empire Arena — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.production and customize with your production values.
# NEVER commit .env.production or any secrets to source control.

# Application Environment Mode ('production' strictly enforces security keys)
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# Secret Management & Encryption Key
# ------------------------------------------------------------------------------
# 32-byte Fernet key or strong high-entropy passphrase used to encrypt provider credentials.
# In production (ENVIRONMENT=production), this variable is REQUIRED.
# Generate a new Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEY=REPLACE_WITH_STRONG_PRODUCTION_FERNET_KEY_OR_PASSPHRASE

# ------------------------------------------------------------------------------
# Access Boundary API Key
# ------------------------------------------------------------------------------
# Single-tenant deployment authorization key protecting mutating and administrative
# routes (experiment CRUD, provider configuration, run execution, system backups).
# Clients must provide this key via 'X-Empire-Key' header or 'Authorization: Bearer <key>'.
EMPIRE_API_KEY=empire_sec_live_replace_with_secure_random_key_64chars

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of exact domains allowed to make cross-origin requests.
# Wildcards are rejected in production when credentials/cookies are active.
CORS_ORIGINS=https://empire-arena.example.com,https://app.empire-arena.example.com

# ------------------------------------------------------------------------------
# Domain & TLS Configuration (For Caddy Automatic HTTPS)
# ------------------------------------------------------------------------------
# Your public fully qualified domain name (FQDN) pointed via DNS A/AAAA record to your VPS.
DOMAIN=arena.example.com
# Notification email for Let's Encrypt TLS certificate lifecycle notices.
ACME_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# Cookie & Security Flags
# ------------------------------------------------------------------------------
# In HTTPS production, COOKIE_SECURE MUST be true.
COOKIE_SECURE=true
# Interactive OpenAPI documentation (/docs, /redoc) is disabled in production by default.
ENABLE_DOCS=false

# ------------------------------------------------------------------------------
# Persistent Storage & Backups
# ------------------------------------------------------------------------------
# Absolute or container path to SQLite database and backup snapshot directory.
DATABASE_PATH=/app/data/empire_arena.db
BACKUP_DIR=/app/data/backups

# ------------------------------------------------------------------------------
# AI Provider & Local Inference Connectivity
# ------------------------------------------------------------------------------
# Address where Ollama local inference is running.
# If Ollama is on host: http://host.docker.internal:11434
# If Ollama is on a remote desktop via VPN (Tailscale): http://100.x.y.z:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
